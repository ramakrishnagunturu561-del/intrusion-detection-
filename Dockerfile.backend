# Use an official Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory in the container
WORKDIR /app

# Install system dependencies, specifically tshark
RUN apt-get update && apt-get install -y \
    tshark \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy the requirements file into the container
COPY requirements.txt /app/

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend and src directories
COPY backend/ /app/backend/
COPY src/ /app/src/
COPY models/ /app/models/

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Define environment variables
ENV PYTHONPATH="/app:/app/src:/app/backend"
ENV PYTHONUNBUFFERED=1

# Run the app using gunicorn
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "backend.main:app", "-b", "0.0.0.0:8000"]
